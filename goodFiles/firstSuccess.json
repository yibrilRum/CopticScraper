{"title": "Some Coptic Words for Greetings and Social Encounter", "content": [{"english": "Hello (Hi)", "coptic": "Ⲛⲟⲩϥⲣⲓ"}, {"english": "Goodbye", "coptic": "Ⲟⲩϫⲁⲓ"}, {"english": "Be in Peace (of Good Health) in the Lord", "coptic": "Ⲟⲩϫⲁⲓ Ϧⲉⲛ Ⲡ̀ϭⲟⲓⲥ"}, {"english": "Peace (to you) In the Lord", "coptic": "Ⲟⲩϫⲁⲓ Ϧⲉⲛ Ⲡ̀ϭⲟⲓⲥ"}, {"english": "Good", "coptic": "Ⲛⲁⲛⲉϥ"}, {"english": "Very Good", "coptic": "Ⲛⲁⲛⲉϥ Ⲉⲙⲁϣⲱ"}, {"english": "Thanks", "coptic": "Ϣⲉⲡϩⲙⲟⲧ"}, {"english": "Very Good Thanks", "coptic": "Ⲛⲁⲛⲉϥ Ⲉⲙⲁϣⲱ Ϣⲉⲡϩⲙⲟⲧ"}, {"english": "Good Morning", "coptic": "Ⲛⲁⲛⲉ Ⲧⲟⲟⲩⲓ"}, {"english": "Good Day", "coptic": "Ⲛⲁⲛⲉ ⲉϩⲟⲟⲩ"}, {"english": "Good Evening", "coptic": "Ⲛⲁⲛⲉ Ⲣⲟⲩϩⲓ"}, {"english": "Good Night", "coptic": "Ⲛⲁⲛⲉ Ⲉϫⲱⲣϩ"}, {"english": "Good Night My Dear", "coptic": "Ⲛⲁⲛⲉ Ⲉϫⲱⲣϩ Ⲡⲁⲙⲉⲛⲣⲓⲧ"}, {"english": "Good Night My Dear", "coptic": "Ⲛⲁⲛⲉ Ⲉϫⲱⲣϩ ⲦⲁⲙⲉⲛⲣⲓϮ"}, {"english": "Good Night My Dears", "coptic": "Ⲛⲁⲛⲉ Ⲉϫⲱⲣϩ ⲠⲁⲙⲉⲛⲣⲁϮ"}, {"english": "Thank You (S.M.)", "coptic": "Ϯϣⲉⲡⲉϩⲙⲟⲧ ⲉⲛⲧⲟⲧⲕ"}, {"english": "Thank You (S.F.)", "coptic": "Ϯϣⲉⲡⲉϩⲙⲟⲧ ⲉⲛⲧⲟⲧⲥ"}, {"english": "Thank You (Plural)", "coptic": "Ϯϣⲉⲡⲉϩⲙⲟⲧ ⲉⲛⲧⲟⲧⲛ"}, {"english": "With Pleasure, You Are Welcome, Nothing", "coptic": "Ⲙ̀ⲙⲟⲛ ϩ̀ⲗⲓ"}, {"english": "Something, Anyone", "coptic": "(ⲟⲩ) ϩ̀ⲗⲓ"}, {"english": "Everything", "coptic": "ϩ̀ⲗⲓ ⲛⲓⲃⲉⲛ"}, {"english": "Something Good", "coptic": "Ⲟⲩ ϩ̀ⲗⲓ"}, {"english": "This is Something Good", "coptic": "Ⲟⲩ ϩ̀ⲗⲓ ⲉⲛⲁⲛⲉϥ ⲡⲉ"}, {"english": "I am honored (S.)", "coptic": "Ⲁⲛⲟⲕ ϣⲓ ⲧⲁⲓⲟⲩ"}, {"english": "We are honored (Pl.)", "coptic": "Ⲁⲛⲟⲛ ϣⲓ ⲧⲁⲓⲟⲩ"}, {"english": "God Willing", "coptic": "Ⲁⲣⲉ ϣⲁⲛ Ⲉϥⲛⲟⲩϯ ⲟⲩⲱϣ"}, {"english": "If you please", "coptic": "Ⲉⲩⲟⲗ ϫⲉⲛ ⲡⲓ ⲉϩⲙⲟⲧ"}, {"english": "Excuse me", "coptic": "Ϧⲁ ⲠⲉⲕϨⲱⲛ"}, {"english": "God be With You (S.M.)", "coptic": "ⲫⲛⲟⲩϯ ⲛⲉⲙⲁⲕ"}, {"english": "God be With You (S.F.)", "coptic": "ⲫⲛⲟⲩϯ ⲛⲉⲙⲉ"}, {"english": "God be With You (Pl.)", "coptic": "ⲫⲛⲟⲩϯ ⲛⲉⲙⲱⲧⲉⲛ"}, {"english": "Be Kind or Graceful to me", "coptic": "Ⲁⲣⲉⲟⲩⲓ ⲛⲉⲙⲓ `ⲛⲟⲩⲉϩⲙⲟⲧ"}, {"english": "Yes", "coptic": "Ⲥⲉ"}, {"english": "Yes", "coptic": "Ⲁϩⲁ"}, {"english": "No", "coptic": "Ⲉⲙⲙⲟⲛ"}, {"english": "Of Course, Certainly", "coptic": "Ⲁϩⲁ ⲉⲛⲧⲱⲟⲩⲛ"}, {"english": "Complete", "coptic": "Ϫⲱⲕ ⲉⲃⲟⲗ"}, {"english": "Precisely", "coptic": "Ϫⲉⲛ ϫⲱⲕ ⲉⲃⲟⲗ"}, {"english": "How are you? (S.M)", "coptic": "Ⲁϣ ⲡⲉ ⲡⲉⲕⲣⲏϯ"}, {"english": "How are you? (S.F)", "coptic": "Ⲁϣ ⲡⲉ ⲡⲉⲣⲏϯ"}, {"english": "How are you? (Pl.)", "coptic": "Ⲁϣ ⲡⲉ ⲡⲉⲧⲉⲛⲣⲏϯ"}, {"english": "Good, I Thank God (S.M) & (S.F.)", "coptic": "Ⲛⲁⲛⲉϥ, Ϯ ϣⲉⲡⲉϩⲙⲟⲧ ⲉⲙ ⲫⲛⲟⲩϯ"}, {"english": "And you too, how are you? (S.M.)", "coptic": "Ⲟⲩⲟϩ ⲛ̀ⲑⲟⲕ ⲟⲛ. Ⲁϣ ⲡⲉ ⲡⲉⲕⲣⲏϯ"}, {"english": "And you too, how are you? (S.F.)", "coptic": "Ⲟⲩⲟϩ ⲛ̀ⲑⲟ ⲟⲛ. Ⲁϣ ⲡⲉ ⲡⲉⲣⲏϯ"}, {"english": "And you too, how are you, all? (Pl. M.)", "coptic": "Ⲟⲩⲟϩ ⲛ̀ⲑⲱⲧⲉⲛ ⲟⲛ. Ⲁϣ ⲡⲉ ⲡⲉⲧⲉⲛⲣⲏϯ"}, {"english": "And you too, how are you, all? (Pl. F.)", "coptic": "Ⲟⲩⲟϩ ⲛ̀ⲑⲱⲧⲉⲛ ⲟⲛ. Ⲁϣ ⲡⲉ ⲡⲉⲧⲉⲛⲣⲏϯ"}, {"english": "I am fine, in peace", "coptic": "ϯⲟⲩⲟϫ"}, {"english": "I Thank You Very Much", "coptic": "Ϯϣⲉⲡⲉϩⲙⲟⲧ ⲛⲧⲟⲧϥ ⲙⲫⲛⲟⲩϯ"}, {"english": "Good, Fair, Nice", "coptic": "Ⲛⲁⲛⲉ"}, {"english": "It is Good, It is Right", "coptic": "Ⲛⲁⲛⲉⲥ"}, {"english": "Greeting to you (S. M.)", "coptic": "Ⲭⲉⲣⲉ ⲛⲁⲕ"}, {"english": "Greeting to you (S. F.)", "coptic": "Ⲭⲉⲣⲉ ⲛⲉ"}, {"english": "Greeting to you (Pl. M.)", "coptic": "Ⲭⲉⲣⲉ ⲛⲱⲧⲉⲛ"}, {"english": "Greeting to you (Pl. F.)", "coptic": "Ⲭⲉⲣⲉ ⲛⲱⲧⲉⲛ"}, {"english": "And to you... my dear (S.M.)", "coptic": "Ⲟⲩⲱϩ ⲛⲁⲕ ⲟⲛ... ⲡⲁ ⲙⲉⲛⲣⲓⲧ"}, {"english": "And to you... my dear (S.F.)", "coptic": "Ⲟⲩⲱϩ ⲛⲁⲕ ⲛⲉ... ⲧⲁ ⲙⲉⲛⲣⲓⲧ"}, {"english": "And to you... my dears (Pl.)", "coptic": "Ⲟⲩⲱϩ ⲛⲱⲧⲉⲛ... ⲛⲓ ⲙⲉⲛⲣⲁⲧⲓ"}, {"english": "Peace to you (S.M.)", "coptic": "ϮϨⲏⲣⲓⲛⲏ ⲛⲁⲕ"}, {"english": "Peace to you (S.F.)", "coptic": "ϮϨⲏⲣⲓⲛⲏ ⲛⲉ"}, {"english": "Peace to you (Pl. M.)", "coptic": "ϮϨⲏⲣⲓⲛⲏ ⲛⲱⲧⲉⲛ"}, {"english": "Peace to you (Pl. F.)", "coptic": "ϮϨⲏⲣⲓⲛⲏ ⲛⲱⲧⲉⲛ"}, {"english": "Good Morning", "coptic": "Ⲛⲁⲛⲉ Ⲁⲧⲟⲟⲩⲓ"}, {"english": "Good Day", "coptic": "Ⲛⲟϥⲣⲓ Ⲉϩⲟⲟⲩ"}, {"english": "Good Evening", "coptic": "Ⲛⲟϥⲣⲓ Ⲉϫⲱⲣϩ"}, {"english": "Good Night", "coptic": "Ⲛⲟϥⲣⲓ Ⲣⲟⲩϩⲓ"}, {"english": "Happy Feast", "coptic": "Ⲛⲟϥⲣⲓ Ϣⲁⲓ"}, {"english": "Happy New Year", "coptic": "Ⲛⲟϥⲣⲓ Ⲣⲟⲙⲡⲓ  ⲙ̀ⲃⲉⲣⲓ"}, {"english": "You Too", "coptic": "Ⲟⲩⲟϩ Ⲉⲛⲑⲟⲕ"}, {"english": "Happy Nativity Feast", "coptic": "Ⲛⲟϥⲣⲓ ϣⲁⲓ  ⲙ̀Ⲡ̀ϫⲓⲛⲙⲉⲥⲓ"}, {"english": "Christ is Born", "coptic": "Ⲡⲭⲥ Ⲁⲩⲙⲁⲥϥ"}, {"english": "Truly He Is Born", "coptic": "Ϧⲉⲛ Ⲟⲩⲙⲉⲑⲙⲓ Ⲁⲩⲙⲁⲥϥ"}, {"english": "Happy Theophany Feast", "coptic": "Ⲛⲟϥⲣⲓ Ϣⲁⲓ Ⲙ̀ⲡ̀ϫⲓⲛⲟⲙⲥ"}, {"english": "Christ is Risen", "coptic": "Ⲡⲭⲥ Ⲁϥⲧⲟⲛϥ"}, {"english": "Truly He is Risen", "coptic": "Ϧⲉⲛ Ⲟⲩⲙⲉⲑⲙⲓ Ⲁϥⲧⲟⲛϥ"}, {"english": "Christ is Risen", "coptic": "Ⲡⲭⲥ Ⲁⲛⲉⲥⲧⲏ"}, {"english": "Truly He is Risen", "coptic": "Ⲁⲗⲏⲑⲟⲥ Ⲁⲛⲉⲥⲧⲏ"}]}
